# 1. 读取工艺库（Liberty 格式）
read_liberty -lib \
  ./platforms/asap7/lib/CCS/asap7sc7p5t_SEQ_RVT_FF_ccs_220123.lib \
  ./objects/asap7/aes_secworks/base/lib/asap7sc7p5t_AO_RVT_FF_nldm_211120.lib \
  ./objects/asap7/aes_secworks/base/lib/asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib \
  ./objects/asap7/aes_secworks/base/lib/asap7sc7p5t_OA_RVT_FF_nldm_211120.lib \
  ./objects/asap7/aes_secworks/base/lib/asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib \
  ./objects/asap7/aes_secworks/base/lib/asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib

# 2. 读取 Verilog 源文件
read_verilog ./designs/asap7/src/aes_secworks/aes_core.v
read_verilog ./designs/asap7/src/aes_secworks/aes.v
read_verilog ./designs/asap7/src/aes_secworks/aes_key_mem.v
read_verilog ./designs/asap7/src/aes_secworks/aes_encipher_block.v
read_verilog ./designs/asap7/src/aes_secworks/aes_inv_sbox.v
read_verilog ./designs/asap7/src/aes_secworks/aes_sbox.v
read_verilog ./designs/asap7/src/aes_secworks/aes_decipher_block.v

# 3. 设置顶层模块
hierarchy -check -top aes

# 4. 综合与优化
synth -top aes -flatten
opt -purge

# 5. 映射触发器
dfflibmap -liberty ./platforms/asap7/lib/CCS/asap7sc7p5t_SEQ_RVT_FF_ccs_220123.lib

# 6. 逻辑映射
abc -liberty ./platforms/asap7/lib/CCS/asap7sc7p5t_SEQ_RVT_FF_ccs_220123.lib

# 7. 清理与精简逻辑
setundef -zero
splitnets -ports
opt_clean -purge
opt

# 8. 写出门级网表
write_verilog -noattr ./results/separated/synth/aes_synth.v

# 9. 生成统计报告
stat
